<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>server</AssemblyName>
    <RootNamespace>Twelve</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <CppCompilerAndLinker>gcc</CppCompilerAndLinker>
  </PropertyGroup>

  <!-- dotnet publish -p:Log=true compiles the trace logging in (TRACE_LOG). Otherwise Log.* calls are removed. -->
  <PropertyGroup Condition="'$(Log)' == 'true'">
    <DefineConstants>$(DefineConstants);TRACE_LOG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <DirectPInvoke Include="sqlite3" />
    <NativeLibrary Include="obj/sqlite/libsqlite3.a" />
    <DirectPInvoke Include="libc" />
  </ItemGroup>
</Project>
